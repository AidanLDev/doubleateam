---
import DefaultLayout from '../layouts/DefaultLayout.astro'
import MediaLinksLogo from '../components/contact-me/MediaLinksLogo.astro'
import { socialMediaDataAidan, socialMediaDataArni } from '../lib/SocialMediaCardData'
---

<DefaultLayout
  title="Contact us"
  description="Find Aidan & Arni on social media. Follow along for travel tips, guides and updates, or get in touch with any questions."
>
  <h1 class="sr-only">Contact Aidan & Arni</h1>
  <section>
    <div class="mb-4 flex items-center justify-center gap-4 border-b border-gray-600 pb-8">
      <img src="/us/AidanAvatar.webp" alt="Aidan pretending he's on the phone" width="150px" height="150px" />
      <h2>Find Aidan On...</h2>
    </div>
    <div class="contact-me-container container">
      {socialMediaDataAidan.map((mediaData) => (
        <MediaLinksLogo imgSrc={mediaData.imgSrc} imgAlt={mediaData.imgAlt} link={mediaData.link} />
      ))}
    </div>
    <div class="mb-4 flex items-center justify-center gap-4 border-b border-gray-600 pb-8">
      <img src="/us/ArniAvatar.png" alt="Arni posing in a cafe" width="150px" height="150px" />
      <h2>Find Arni On...</h2>
    </div>
    <div class="contact-me-container container">
      {socialMediaDataArni.map((mediaData) => (
        <MediaLinksLogo imgSrc={mediaData.imgSrc} imgAlt={mediaData.imgAlt} link={mediaData.link} />
      ))}
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  // Styled like the h1s these used to be; the page h1 is visually hidden
  h2 {
    text-align: center;
    padding: 1rem 0;
    font-size: 2.25rem;
    line-height: 3.375rem;

    @media (min-width: 48em) {
      font-size: 3rem;
      line-height: 3.625rem;
    }
  }
  .contact-me-container {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 0 4rem;
    @media (max-width: 750px) {
      gap: 0.5rem;
      padding: 0 1rem;
    }
  }
</style>
